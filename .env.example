# Path to the SQLite database file (default: ./data/app.db)
DATABASE_PATH=

# Directory for uploaded files / receipts (default: ./data/uploads)
UPLOADS_PATH=

# Maximum PDF upload size in bytes (default: 100 MiB).
MAX_PDF_UPLOAD_BYTES=104857600

# Local Tesseract OCR language packs installed in the runtime image.
PDF_OCR_LANGUAGES=deu+eng

# Optional absolute path to the Tesseract executable. On Windows, set this
# when its installation directory is not on PATH.
TESSERACT_PATH=

# Secret for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Public URL of the deployed app. Use http://localhost:3000 for `npm run dev`.
BETTER_AUTH_URL=https://startup.elarbol.me

# SMTP for account invitations. SMTP_FROM must be a plain email address.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional comma-separated browser origins accepted by Better Auth in addition
# to BETTER_AUTH_URL (for example a local development proxy).
BETTER_AUTH_TRUSTED_ORIGINS=

# Host interface exposed by Docker Compose. Keep this on loopback when using
# Cloudflare Tunnel so the application cannot be reached around Access.
APP_BIND_ADDRESS=127.0.0.1

# Host port for direct local access to the container. The application and
# cloudflared still communicate on port 3000 inside the Compose network.
APP_HOST_PORT=3007

# Token for the optional `cloudflare` Docker Compose profile. Create a remotely
# managed tunnel in Cloudflare, then set the raw token in your untracked .env.
# Never paste the token into docker-compose.yml. Treat it as a secret.
CLOUDFLARE_TUNNEL_TOKEN=

# Office documents (ONLYOFFICE Docs), see docs/office-documents.md.
# Two different random secrets, at least 32 characters each
# (e.g. `openssl rand -hex 32`). Inbox signs editor configs and requests to the
# document server; outbox verifies its save callbacks.
ONLYOFFICE_INBOX_SECRET=
ONLYOFFICE_OUTBOX_SECRET=
# Docker Compose sets these two; for `npm run dev` with
# docker-compose.office-dev.yml use http://localhost:8085 and
# http://host.docker.internal:3000 and open the app on http://localhost:8086.
ONLYOFFICE_INTERNAL_URL=
APP_INTERNAL_URL=
ONLYOFFICE_PUBLIC_PATH=/office
# "true" shows office documents as downloads only (no editor).
OFFICE_DISABLED=false

# Internal LanguageTool endpoint. Docker Compose defaults to its private service
# address; use http://localhost:8010 only when running LanguageTool separately.
LANGUAGETOOL_URL=http://languagetool:8010

# Optional AI-assisted calendar import. Without a key the deterministic
# ICS/JSON-LD/text parser remains available.
OPENAI_API_KEY=
OPENAI_CALENDAR_MODEL=gpt-6-astra
OPENAI_MINUTES_MODEL=gpt-6-astra

# Meetings (docs/meetings.md): recordings are transcribed and summarised with
# OpenAI unless a meeting's AI setting is off. Requires ffmpeg/ffprobe locally
# (set FFMPEG_PATH/FFPROBE_PATH if they are not on PATH); the Docker image has them.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_MEETINGS_MODEL=gpt-6-astra
# Largest single recording upload in bytes (default 4 GiB).
MEETINGS_MAX_UPLOAD_BYTES=4294967296
# Long recordings are transcribed in chunks of this many seconds.
MEETINGS_TRANSCRIBE_CHUNK_SECONDS=1200
# "1" replaces OpenAI with fixed fixture output (tests, local UI work).
MEETINGS_FAKE_AI=
